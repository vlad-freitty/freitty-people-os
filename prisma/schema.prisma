// FREITTY People OS — schema. Entities follow PRD section 3; anything beyond it is listed in CLAUDE.md.
// Conventions: ids are uuid, timestamps are UTC, date-only values use @db.Date,
// every business table has createdAt/updatedAt/createdById/deletedAt (soft delete).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmploymentType {
  employee
  contractor
}

enum EmployeeStatus {
  candidate
  onboarding
  active
  offboarding
  left
}

enum Locale {
  uk
  en
}

enum RateType {
  hourly
  per_shift
  monthly
}

/// all = every record; departments = departments the user heads (with sub-departments); self = own record only
enum PermissionScope {
  all
  departments
  self
}

// ───────────── Org structure ─────────────

model Company {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  country     String
  departments Department[]
  employees   Employee[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdById String?      @db.Uuid
  deletedAt   DateTime?

  @@map("company")
}

model Department {
  id          String           @id @default(uuid()) @db.Uuid
  companyId   String           @db.Uuid
  company     Company          @relation(fields: [companyId], references: [id])
  name        String
  parentId    String?          @db.Uuid
  parent      Department?      @relation("DepartmentTree", fields: [parentId], references: [id])
  children    Department[]     @relation("DepartmentTree")
  heads       DepartmentHead[]
  employees   Employee[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdById String?          @db.Uuid
  deletedAt   DateTime?

  @@unique([companyId, name])
  @@map("department")
}

model Location {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  country     String
  state       String?
  timezone    String // IANA, e.g. Europe/Kyiv, America/New_York
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdById String?    @db.Uuid
  deletedAt   DateTime?

  @@map("location")
}

model DepartmentHead {
  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id])
  employeeId   String     @db.Uuid
  employee     Employee   @relation(fields: [employeeId], references: [id])
  createdAt    DateTime   @default(now())
  createdById  String?    @db.Uuid

  @@id([departmentId, employeeId])
  @@map("department_head")
}

// ───────────── People ─────────────

model Employee {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String?          @unique @db.Uuid
  user            User?            @relation(fields: [userId], references: [id])
  firstName       String
  lastName        String
  workEmail       String           @unique
  phone           String?
  photo           String?
  companyId       String           @db.Uuid
  company         Company          @relation(fields: [companyId], references: [id])
  departmentId    String           @db.Uuid
  department      Department       @relation(fields: [departmentId], references: [id])
  locationId      String?          @db.Uuid
  location        Location?        @relation(fields: [locationId], references: [id])
  position        String
  managerId       String?          @db.Uuid
  manager         Employee?        @relation("EmployeeManager", fields: [managerId], references: [id])
  reports         Employee[]       @relation("EmployeeManager")
  employmentType  EmploymentType
  hireDate        DateTime?        @db.Date
  probationEnd    DateTime?        @db.Date
  birthDate       DateTime?        @db.Date
  showBirthday    Boolean          @default(true)
  status          EmployeeStatus   @default(active)
  /// FK to AbsencePolicy is added in phase 2, when the table exists
  absencePolicyId String?          @db.Uuid
  locale          Locale           @default(uk)
  rates           RateHistory[]
  headOf          DepartmentHead[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdById     String?          @db.Uuid
  deletedAt       DateTime?

  @@index([departmentId])
  @@index([companyId])
  @@map("employee")
}

model User {
  id          String    @id @default(uuid()) @db.Uuid
  /// Microsoft Entra ID object id (replaces google_sub from the PRD, see CLAUDE.md)
  entraOid    String?   @unique
  email       String    @unique
  roleId      String    @db.Uuid
  role        Role      @relation(fields: [roleId], references: [id])
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  employee    Employee?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  deletedAt   DateTime?

  @@map("app_user")
}

model RateHistory {
  id            String    @id @default(uuid()) @db.Uuid
  employeeId    String    @db.Uuid
  employee      Employee  @relation(fields: [employeeId], references: [id])
  rateType      RateType
  amount        Decimal   @db.Decimal(12, 2)
  currency      String    @db.Char(3)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?   @db.Uuid
  deletedAt     DateTime?

  /// one rate timeline per employee (rate type may change over time), no two records start on the same day
  @@unique([employeeId, effectiveFrom])
  @@map("rate_history")
}

// ───────────── Roles & permissions (configurable, approved deviation from PRD — see CLAUDE.md) ─────────────

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  nameUk      String
  nameEn      String?
  /// system roles cannot be deleted; superadmin also cannot be edited
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdById String?          @db.Uuid
  deletedAt   DateTime?

  @@map("role")
}

model RolePermission {
  roleId     String          @db.Uuid
  role       Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// key from src/server/authz/permissions.ts
  permission String
  scope      PermissionScope

  @@id([roleId, permission])
  @@map("role_permission")
}

// ───────────── Service ─────────────

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @db.Uuid
  action       String
  entity       String
  entityId     String
  before       Json?
  after        Json?
  /// department of the affected record at the time of the action — used for scoped access to the log
  departmentId String?  @db.Uuid
  /// employee the action is about (for "own actions / about me" filtering)
  employeeId   String?  @db.Uuid
  at           DateTime @default(now())

  @@index([actorId])
  @@index([departmentId])
  @@index([entity, entityId])
  @@map("audit_log")
}
