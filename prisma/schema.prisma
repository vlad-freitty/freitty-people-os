// FREITTY People OS — schema. Entities follow PRD section 3; anything beyond it is listed in CLAUDE.md.
// Conventions: ids are uuid, timestamps are UTC, date-only values use @db.Date,
// every business table has createdAt/updatedAt/createdById/deletedAt (soft delete).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmploymentType {
  employee
  contractor
}

enum EmployeeStatus {
  candidate
  onboarding
  active
  offboarding
  left
}

enum Locale {
  uk
  en
}

enum RateType {
  hourly
  per_shift
  monthly
}

/// all = every record; departments = departments the user heads (with sub-departments); self = own record only
enum PermissionScope {
  all
  departments
  self
}

// ───────────── Org structure ─────────────

model Company {
  id                         String                    @id @default(uuid()) @db.Uuid
  name                       String                    @unique
  country                    String
  departments                Department[]
  employees                  Employee[]
  /// absence policies per type for the company (phase 6; the most specific assignment wins)
  policyAssignments          AbsencePolicyAssignment[]
  workWeeks                  WorkWeek[]
  /// multiplier for shifts on non-working days (PRD 6, default 1.0)
  nonWorkingShiftCoefficient Decimal                   @default(1.0) @db.Decimal(4, 2)
  shifts                     Shift[]
  paymentPeriods             PaymentPeriod[]
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  createdById                String?                   @db.Uuid
  deletedAt                  DateTime?

  @@map("company")
}

model Department {
  id                String                    @id @default(uuid()) @db.Uuid
  companyId         String                    @db.Uuid
  company           Company                   @relation(fields: [companyId], references: [id])
  name              String
  parentId          String?                   @db.Uuid
  parent            Department?               @relation("DepartmentTree", fields: [parentId], references: [id])
  children          Department[]              @relation("DepartmentTree")
  heads             DepartmentHead[]
  employees         Employee[]
  requestTypes      RequestType[]
  requests          Request[]
  shifts            Shift[]
  /// absence policies per type for the department (phase 6); apply to sub-departments unless they set their own
  policyAssignments AbsencePolicyAssignment[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  createdById       String?                   @db.Uuid
  deletedAt         DateTime?

  @@unique([companyId, name])
  @@map("department")
}

model Location {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  country     String
  state       String?
  timezone    String // IANA, e.g. Europe/Kyiv, America/New_York
  employees   Employee[]
  workWeeks   WorkWeek[]
  shifts      Shift[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdById String?    @db.Uuid
  deletedAt   DateTime?

  @@map("location")
}

model DepartmentHead {
  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id])
  employeeId   String     @db.Uuid
  employee     Employee   @relation(fields: [employeeId], references: [id])
  createdAt    DateTime   @default(now())
  createdById  String?    @db.Uuid

  @@id([departmentId, employeeId])
  @@map("department_head")
}

// ───────────── People ─────────────

model Employee {
  id                String                    @id @default(uuid()) @db.Uuid
  userId            String?                   @unique @db.Uuid
  user              User?                     @relation(fields: [userId], references: [id])
  firstName         String
  lastName          String
  workEmail         String                    @unique
  phone             String?
  photo             String?
  companyId         String                    @db.Uuid
  company           Company                   @relation(fields: [companyId], references: [id])
  departmentId      String                    @db.Uuid
  department        Department                @relation(fields: [departmentId], references: [id])
  locationId        String?                   @db.Uuid
  location          Location?                 @relation(fields: [locationId], references: [id])
  position          String
  managerId         String?                   @db.Uuid
  manager           Employee?                 @relation("EmployeeManager", fields: [managerId], references: [id])
  reports           Employee[]                @relation("EmployeeManager")
  employmentType    EmploymentType
  hireDate          DateTime?                 @db.Date
  probationEnd      DateTime?                 @db.Date
  birthDate         DateTime?                 @db.Date
  showBirthday      Boolean                   @default(true)
  status            EmployeeStatus            @default(active)
  /// level from the PTO & Benefits Guide (phase 6); visible with the full profile only
  grade             EmployeeGrade?
  /// personal absence policies per type; override department and company (phase 6)
  policyAssignments AbsencePolicyAssignment[]
  balances          AbsenceBalance[]
  absences          Absence[]
  shifts            Shift[]
  payments          Payment[]
  bonuses           Bonus[]
  locale            Locale                    @default(uk)
  rates             RateHistory[]
  headOf            DepartmentHead[]
  accessGrants      AccessGrant[]
  assets            Asset[]
  documents         Document[]
  ownedSystems      System[]
  initiated         Request[]                 @relation("RequestInitiator")
  subjectOf         Request[]                 @relation("RequestSubject")
  assignedSteps     StepInstance[]            @relation("StepAssignee")
  comments          Comment[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  createdById       String?                   @db.Uuid
  deletedAt         DateTime?

  @@index([departmentId])
  @@index([companyId])
  @@map("employee")
}

model User {
  id                  String         @id @default(uuid()) @db.Uuid
  email               String         @unique
  /// name for accounts without an employee card (the first admin created by `npm run admin:create`)
  displayName         String?
  /// scrypt hash (phase 7: email + password sign-in); null = the account cannot sign in with a password yet
  passwordHash        String?
  /// set when an admin issued a one-time password: every page asks to change it first
  mustChangePassword  Boolean        @default(false)
  passwordChangedAt   DateTime?
  /// technical: failed attempts in a row; 5 → lockedUntil = now + 15 min
  failedLoginCount    Int            @default(0)
  lockedUntil         DateTime?
  /// technical: part of the session token — bumped on password reset / deactivation to end old sessions
  sessionVersion      Int            @default(0)
  roleId              String         @db.Uuid
  role                Role           @relation(fields: [roleId], references: [id])
  isActive            Boolean        @default(true)
  lastLoginAt         DateTime?
  /// technical: secret for the personal ICS subscription (phase 2); rotating it invalidates the old link
  calendarToken       String?        @unique
  /// technical: Telegram link (phase 5) — chat id after /start, one-time code while linking
  telegramChatId      String?        @unique
  telegramLinkCode    String?        @unique
  telegramLinkExpires DateTime?
  /// per type and channel: {step_assigned: {in_app: true, telegram: false}, …}; missing = enabled
  notificationPrefs   Json?
  notifications       Notification[]
  employee            Employee?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  createdById         String?        @db.Uuid
  deletedAt           DateTime?

  @@map("app_user")
}

model RateHistory {
  id            String    @id @default(uuid()) @db.Uuid
  employeeId    String    @db.Uuid
  employee      Employee  @relation(fields: [employeeId], references: [id])
  rateType      RateType
  amount        Decimal   @db.Decimal(12, 2)
  currency      String    @db.Char(3)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?   @db.Uuid
  deletedAt     DateTime?

  /// one rate timeline per employee (rate type may change over time), no two records start on the same day
  @@unique([employeeId, effectiveFrom])
  @@map("rate_history")
}

// ───────────── Roles & permissions (configurable, approved deviation from PRD — see CLAUDE.md) ─────────────

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  nameUk      String
  nameEn      String?
  /// system roles cannot be deleted; superadmin also cannot be edited
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdById String?          @db.Uuid
  deletedAt   DateTime?

  @@map("role")
}

model RolePermission {
  roleId     String          @db.Uuid
  role       Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// key from src/server/authz/permissions.ts
  permission String
  scope      PermissionScope

  @@id([roleId, permission])
  @@map("role_permission")
}

// ───────────── Service ─────────────

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @db.Uuid
  action       String
  entity       String
  entityId     String
  before       Json?
  after        Json?
  /// department of the affected record at the time of the action — used for scoped access to the log
  departmentId String?  @db.Uuid
  /// employee the action is about (for "own actions / about me" filtering)
  employeeId   String?  @db.Uuid
  at           DateTime @default(now())

  @@index([actorId])
  @@index([departmentId])
  @@index([entity, entityId])
  @@map("audit_log")
}

// ───────────── Phase 1: accesses, assets, documents (PRD 3) ─────────────

enum AssetType {
  laptop
  phone
  license
  other
}

enum DocumentType {
  contract
  nda
  act
  invoice
  w9
  other
}

enum DocumentStatus {
  active
  expired
  archived
}

model System {
  id              String             @id @default(uuid()) @db.Uuid
  name            String             @unique
  ownerEmployeeId String?            @db.Uuid
  owner           Employee?          @relation(fields: [ownerEmployeeId], references: [id])
  isActive        Boolean            @default(true)
  bundleItems     AccessBundleItem[]
  grants          AccessGrant[]
  steps           StepInstance[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  createdById     String?            @db.Uuid
  deletedAt       DateTime?

  @@map("system")
}

model AccessBundle {
  id             String             @id @default(uuid()) @db.Uuid
  name           String             @unique
  /// matched against Employee.position (case-insensitive) to pre-fill access requests
  positionOrRole String
  items          AccessBundleItem[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  createdById    String?            @db.Uuid
  deletedAt      DateTime?

  @@map("access_bundle")
}

model AccessBundleItem {
  bundleId    String       @db.Uuid
  bundle      AccessBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  systemId    String       @db.Uuid
  system      System       @relation(fields: [systemId], references: [id])
  accessLevel String

  @@id([bundleId, systemId])
  @@map("access_bundle_item")
}

/// One active grant per (employee, system) — enforced by a partial unique index in the migration.
model AccessGrant {
  id          String    @id @default(uuid()) @db.Uuid
  employeeId  String    @db.Uuid
  employee    Employee  @relation(fields: [employeeId], references: [id])
  systemId    String    @db.Uuid
  system      System    @relation(fields: [systemId], references: [id])
  accessLevel String
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?
  requestId   String?   @db.Uuid
  request     Request?  @relation(fields: [requestId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid

  @@index([employeeId])
  @@map("access_grant")
}

model Asset {
  id           String    @id @default(uuid()) @db.Uuid
  type         AssetType
  name         String
  serialOrSeat String?
  monthlyCost  Decimal?  @db.Decimal(12, 2)
  /// technical: needed to sum license costs per currency
  currency     String?   @db.Char(3)
  assignedToId String?   @db.Uuid
  assignedTo   Employee? @relation(fields: [assignedToId], references: [id])
  assignedAt   DateTime?
  returnedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?   @db.Uuid
  deletedAt    DateTime?

  @@index([assignedToId])
  @@map("asset")
}

model Document {
  id          String         @id @default(uuid()) @db.Uuid
  employeeId  String         @db.Uuid
  employee    Employee       @relation(fields: [employeeId], references: [id])
  type        DocumentType
  /// storage key; files live in private storage and are served via short-lived links
  fileKey     String
  fileName    String
  mimeType    String
  size        Int
  period      String?
  validFrom   DateTime?      @db.Date
  validTo     DateTime?      @db.Date
  status      DocumentStatus @default(active)
  requestId   String?        @db.Uuid
  request     Request?       @relation(fields: [requestId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdById String?        @db.Uuid
  deletedAt   DateTime?

  @@index([employeeId])
  @@map("document")
}

// ───────────── Phase 1: request engine (PRD 4) ─────────────

enum RequestKind {
  generic
  hiring
  onboarding
  access
  offboarding
  absence
  bonus
}

enum VersionStatus {
  draft
  published
  archived
}

enum FieldType {
  text
  textarea
  number
  date
  date_range
  select
  multiselect
  person
  file
  /// systems with an access level each — approved addition (phase 1 plan, decision 3)
  systems
}

enum StepType {
  approve
  task
  fill
  document
  child_request
}

enum AssigneeRule {
  person
  /// technical: needed by the ARM seed template ("підтвердження ініціатором")
  initiator
  initiator_dept_head
  subject_dept_head
  /// the subject's direct manager (Employee.managerId), else the department head (phase 6)
  subject_manager
  system_owner
  role_first_free
}

enum RequestStatus {
  draft
  in_progress
  done
  rejected
  cancelled
}

enum StepStatus {
  waiting
  active
  needs_assignment
  done
  rejected
  skipped
}

model RequestType {
  id               String               @id @default(uuid()) @db.Uuid
  code             String               @unique
  nameUk           String
  nameEn           String?
  kind             RequestKind
  /// null = global template
  departmentId     String?              @db.Uuid
  department       Department?          @relation(fields: [departmentId], references: [id])
  /// {mode: "all" | "departments" | "roles", departmentIds?: string[], roleCodes?: string[]}
  whoCanInitiate   Json
  currentVersionId String?              @unique @db.Uuid
  currentVersion   RequestTypeVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions         RequestTypeVersion[] @relation("TypeVersions")
  childOfSteps     StepTemplate[]       @relation("ChildRequestType")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  createdById      String?              @db.Uuid
  deletedAt        DateTime?

  @@map("request_type")
}

/// A published version is immutable; requests pin the version they were created with.
model RequestTypeVersion {
  id            String         @id @default(uuid()) @db.Uuid
  requestTypeId String         @db.Uuid
  requestType   RequestType    @relation("TypeVersions", fields: [requestTypeId], references: [id])
  currentOf     RequestType?   @relation("CurrentVersion")
  version       Int
  status        VersionStatus  @default(draft)
  publishedById String?        @db.Uuid
  publishedAt   DateTime?
  fields        FormField[]
  steps         StepTemplate[]
  requests      Request[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdById   String?        @db.Uuid

  @@unique([requestTypeId, version])
  @@map("request_type_version")
}

model FormField {
  id        String             @id @default(uuid()) @db.Uuid
  versionId String             @db.Uuid
  version   RequestTypeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  key       String
  labelUk   String
  labelEn   String?
  type      FieldType
  /// select / multiselect: [{value, labelUk, labelEn?}]
  options   Json?
  required  Boolean            @default(false)
  order     Int

  @@unique([versionId, key])
  @@map("form_field")
}

model StepTemplate {
  id                 String             @id @default(uuid()) @db.Uuid
  versionId          String             @db.Uuid
  version            RequestTypeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  orderGroup         Int
  /// technical: position of the step inside its group, as arranged in the constructor
  order              Int                @default(0)
  nameUk             String
  nameEn             String?
  stepType           StepType
  assigneeRule       AssigneeRule
  /// person: employee id; role_first_free: role code
  assigneeValue      String?
  slaDays            Int
  /// task: [{labelUk, labelEn?}]
  checklist          Json?
  /// fill: form field keys the assignee must fill
  requiredFields     String[]
  /// {action: "close" | "return", group?: number}
  onReject           Json
  /// child_request: which request type to start
  childRequestTypeId String?            @db.Uuid
  childRequestType   RequestType?       @relation("ChildRequestType", fields: [childRequestTypeId], references: [id])
  /// document: type of the Document created from the uploaded file
  documentType       DocumentType?
  instances          StepInstance[]

  @@index([versionId])
  @@map("step_template")
}

model Request {
  id                   String              @id @default(uuid()) @db.Uuid
  /// human-readable number, REQ-0001
  number               Int                 @unique @default(autoincrement())
  requestTypeVersionId String              @db.Uuid
  version              RequestTypeVersion  @relation(fields: [requestTypeVersionId], references: [id])
  initiatorId          String              @db.Uuid
  initiator            Employee            @relation("RequestInitiator", fields: [initiatorId], references: [id])
  subjectEmployeeId    String?             @db.Uuid
  subject              Employee?           @relation("RequestSubject", fields: [subjectEmployeeId], references: [id])
  status               RequestStatus       @default(draft)
  currentGroup         Int                 @default(0)
  /// department the request belongs to for scoped access: subject's department, else initiator's
  departmentId         String              @db.Uuid
  department           Department          @relation(fields: [departmentId], references: [id])
  /// set on child requests: the parent step waiting for this one
  parentStepId         String?             @unique @db.Uuid
  parentStep           StepInstance?       @relation("ChildRequest", fields: [parentStepId], references: [id])
  completedAt          DateTime?
  values               RequestFieldValue[]
  steps                StepInstance[]      @relation("RequestSteps")
  comments             Comment[]
  grants               AccessGrant[]
  documents            Document[]
  absence              Absence?
  bonus                Bonus?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  createdById          String?             @db.Uuid

  @@index([initiatorId])
  @@index([subjectEmployeeId])
  @@index([departmentId])
  @@map("request")
}

model RequestFieldValue {
  requestId String  @db.Uuid
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fieldKey  String
  value     Json

  @@id([requestId, fieldKey])
  @@map("request_field_value")
}

model StepInstance {
  id                String       @id @default(uuid()) @db.Uuid
  requestId         String       @db.Uuid
  request           Request      @relation("RequestSteps", fields: [requestId], references: [id], onDelete: Cascade)
  stepTemplateId    String       @db.Uuid
  stepTemplate      StepTemplate @relation(fields: [stepTemplateId], references: [id])
  orderGroup        Int
  /// system_owner steps are expanded one per system
  systemId          String?      @db.Uuid
  system            System?      @relation(fields: [systemId], references: [id])
  assigneeId        String?      @db.Uuid
  assignee          Employee?    @relation("StepAssignee", fields: [assigneeId], references: [id])
  status            StepStatus   @default(waiting)
  activatedAt       DateTime?
  dueAt             DateTime?
  completedAt       DateTime?
  completedById     String?      @db.Uuid
  comment           String?
  /// task: indexes of checked checklist items
  checklistState    Json?
  /// technical: an overdue notice is sent once per step (phase 5)
  overdueNotifiedAt DateTime?
  /// document ids attached to this step
  attachments       String[]
  childRequest      Request?     @relation("ChildRequest")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([requestId])
  @@index([assigneeId, status])
  @@map("step_instance")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  requestId String   @db.Uuid
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String   @db.Uuid
  author    Employee @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([requestId])
  @@map("comment")
}

// ───────────── Phase 2: calendar layers (PRD 5) ─────────────

enum LayerEffect {
  non_working
  informational
}

enum LayerSource {
  manual
  ics_import
  csv_import
  system
}

enum SystemLayerKind {
  birthdays
  work_anniversaries
}

enum LayerVisibility {
  all
  assigned_only
}

enum Recurrence {
  none
  yearly
}

enum LayerTarget {
  company
  department
  location
  employee
}

model CalendarLayer {
  id          String            @id @default(uuid()) @db.Uuid
  nameUk      String
  nameEn      String?
  color       String            @default("#7d7a85")
  effect      LayerEffect
  source      LayerSource       @default(manual)
  /// system layers are generated from Employee data, they have no stored events
  systemKind  SystemLayerKind?  @unique
  visibility  LayerVisibility   @default(assigned_only)
  events      CalendarEvent[]
  assignments LayerAssignment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  createdById String?           @db.Uuid
  deletedAt   DateTime?

  @@map("calendar_layer")
}

model CalendarEvent {
  id          String        @id @default(uuid()) @db.Uuid
  layerId     String        @db.Uuid
  layer       CalendarLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)
  titleUk     String
  titleEn     String?
  date        DateTime      @db.Date
  endDate     DateTime?     @db.Date
  recurrence  Recurrence    @default(none)
  /// null = inherit the layer's effect; true/false overrides it for this event (PRD 5)
  nonWorking  Boolean?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdById String?       @db.Uuid
  deletedAt   DateTime?

  @@index([layerId, date])
  @@map("calendar_event")
}

model LayerAssignment {
  layerId    String        @db.Uuid
  layer      CalendarLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)
  targetType LayerTarget
  targetId   String        @db.Uuid

  @@id([layerId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("layer_assignment")
}

/// Working days of the week for a location or a company (ISO 1 = Mon … 7 = Sun). Default Mon–Fri.
model WorkWeek {
  id         String    @id @default(uuid()) @db.Uuid
  locationId String?   @unique @db.Uuid
  location   Location? @relation(fields: [locationId], references: [id])
  companyId  String?   @unique @db.Uuid
  company    Company?  @relation(fields: [companyId], references: [id])
  days       Int[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("work_week")
}

// ───────────── Phase 2: absences and balances (PRD 5) ─────────────

enum AccrualMode {
  upfront
  monthly
}

enum PeriodStart {
  hire_date
  jan_1
  /// calendar months from the hire date (phase 6: Remote Days "per 30 days")
  month
}

enum EmployeeGrade {
  senior_management
  middle_management
  first_line_management
  individual_contributor
}

enum ExpiryMode {
  end_of_period
  months_after
  never
}

enum DayCount {
  working
  calendar
}

enum LedgerType {
  accrual
  usage
  expiry
  /// transfer of the unused part into the next period (phase 2 plan, decision 6)
  carryover
  manual_adjustment
}

enum AbsenceStatus {
  approved
  cancelled
}

model AbsenceType {
  id               String           @id @default(uuid()) @db.Uuid
  code             String           @unique
  nameUk           String
  nameEn           String?
  color            String           @default("#1f7a4d")
  paid             Boolean          @default(true)
  deductsBalance   Boolean          @default(false)
  requiresDocument Boolean          @default(false)
  requiresApproval Boolean          @default(true)
  minDays          Decimal?         @db.Decimal(5, 1)
  maxDays          Decimal?         @db.Decimal(5, 1)
  allowHalfDay     Boolean          @default(false)
  /// a working day, not time off (Remote Day): shown as "remote", never in "who is absent" (phase 6)
  countsAsWorking  Boolean          @default(false)
  absences         Absence[]
  policies         AbsencePolicy[]
  balances         AbsenceBalance[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  createdById      String?          @db.Uuid
  deletedAt        DateTime?

  @@map("absence_type")
}

model AbsencePolicy {
  id                 String                    @id @default(uuid()) @db.Uuid
  name               String                    @unique
  /// the absence type this policy counts (phase 6: one balance per type)
  absenceTypeId      String                    @db.Uuid
  absenceType        AbsenceType               @relation(fields: [absenceTypeId], references: [id])
  /// applies to every eligible employee unless an assignment says otherwise (one default per type)
  isDefault          Boolean                   @default(false)
  daysPerPeriod      Decimal                   @db.Decimal(5, 1)
  accrual            AccrualMode
  periodStart        PeriodStart
  expiry             ExpiryMode
  expiryMonths       Int?
  carryoverMax       Decimal                   @default(0) @db.Decimal(5, 1)
  availableAfterDays Int                       @default(0)
  allowNegative      Boolean                   @default(false)
  countDays          DayCount                  @default(working)
  assignments        AbsencePolicyAssignment[]
  balances           AbsenceBalance[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  createdById        String?                   @db.Uuid
  deletedAt          DateTime?

  @@map("absence_policy")
}

/// Policy of one absence type for a company, a department (and its sub-departments) or one employee (phase 6).
model AbsencePolicyAssignment {
  id            String        @id @default(uuid()) @db.Uuid
  policyId      String        @db.Uuid
  policy        AbsencePolicy @relation(fields: [policyId], references: [id])
  /// technical: copy of policy.absenceTypeId so one target has at most one policy per type
  absenceTypeId String        @db.Uuid
  companyId     String?       @db.Uuid
  company       Company?      @relation(fields: [companyId], references: [id])
  departmentId  String?       @db.Uuid
  department    Department?   @relation(fields: [departmentId], references: [id])
  employeeId    String?       @db.Uuid
  employee      Employee?     @relation(fields: [employeeId], references: [id])
  createdAt     DateTime      @default(now())
  createdById   String?       @db.Uuid

  @@unique([absenceTypeId, companyId])
  @@unique([absenceTypeId, departmentId])
  @@unique([absenceTypeId, employeeId])
  @@map("absence_policy_assignment")
}

/// One accrual period of one employee under one policy; the balance itself is the sum of its ledger entries.
model AbsenceBalance {
  id            String               @id @default(uuid()) @db.Uuid
  employeeId    String               @db.Uuid
  employee      Employee             @relation(fields: [employeeId], references: [id])
  policyId      String               @db.Uuid
  policy        AbsencePolicy        @relation(fields: [policyId], references: [id])
  /// technical: copy of policy.absenceTypeId — the balance of a type is the sum over its periods (phase 6)
  absenceTypeId String               @db.Uuid
  absenceType   AbsenceType          @relation(fields: [absenceTypeId], references: [id])
  periodStart   DateTime             @db.Date
  periodEnd     DateTime             @db.Date
  /// set when the end-of-period carryover has been booked
  closedAt      DateTime?
  entries       AbsenceLedgerEntry[]
  createdAt     DateTime             @default(now())

  @@unique([employeeId, policyId, periodStart])
  @@map("absence_balance")
}

model AbsenceLedgerEntry {
  id             String         @id @default(uuid()) @db.Uuid
  balanceId      String         @db.Uuid
  balance        AbsenceBalance @relation(fields: [balanceId], references: [id])
  type           LedgerType
  amount         Decimal        @db.Decimal(6, 1)
  date           DateTime       @db.Date
  comment        String?
  absenceId      String?        @db.Uuid
  absence        Absence?       @relation(fields: [absenceId], references: [id])
  /// technical: makes the daily job idempotent (e.g. "accrual:<balance>:<date>")
  idempotencyKey String?        @unique
  createdAt      DateTime       @default(now())
  createdById    String?        @db.Uuid

  @@index([balanceId])
  @@map("absence_ledger_entry")
}

model Absence {
  id          String               @id @default(uuid()) @db.Uuid
  employeeId  String               @db.Uuid
  employee    Employee             @relation(fields: [employeeId], references: [id])
  typeId      String               @db.Uuid
  type        AbsenceType          @relation(fields: [typeId], references: [id])
  startDate   DateTime             @db.Date
  endDate     DateTime             @db.Date
  halfDay     Boolean              @default(false)
  days        Decimal              @db.Decimal(5, 1)
  status      AbsenceStatus        @default(approved)
  requestId   String?              @unique @db.Uuid
  request     Request?             @relation(fields: [requestId], references: [id])
  documentId  String?              @db.Uuid
  entries     AbsenceLedgerEntry[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  createdById String?              @db.Uuid

  @@index([employeeId, startDate])
  @@map("absence")
}

// ───────────── Phase 3: shifts, payments, bonuses (PRD 6) ─────────────

enum ShiftStatus {
  planned
  confirmed
  locked
}

enum ShiftSource {
  manual
  csv_import
}

enum PeriodStatus {
  open
  calculated
  locked
}

enum PaymentStatus {
  calculated
  documents_received
  approved
  paid
}

enum PaymentLineKind {
  shifts
  monthly_rate
  bonus
  adjustment
}

enum BonusSource {
  cs_incentive
  manual
}

enum BonusStatus {
  approved
  included
  paid
}

model Shift {
  id            String      @id @default(uuid()) @db.Uuid
  employeeId    String      @db.Uuid
  employee      Employee    @relation(fields: [employeeId], references: [id])
  companyId     String      @db.Uuid
  company       Company     @relation(fields: [companyId], references: [id])
  departmentId  String      @db.Uuid
  department    Department  @relation(fields: [departmentId], references: [id])
  locationId    String?     @db.Uuid
  location      Location?   @relation(fields: [locationId], references: [id])
  startAt       DateTime
  endAt         DateTime
  timezone      String
  /// technical: start date in the shift's time zone — a shift over midnight counts on its start date (PRD 6)
  workDate      DateTime    @db.Date
  shiftType     String      @default("regular")
  status        ShiftStatus @default(planned)
  source        ShiftSource @default(manual)
  confirmedById String?     @db.Uuid
  confirmedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  createdById   String?     @db.Uuid
  deletedAt     DateTime?

  @@unique([employeeId, startAt])
  @@index([companyId, workDate])
  @@index([departmentId, workDate])
  @@map("shift")
}

model PaymentPeriod {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  company     Company      @relation(fields: [companyId], references: [id])
  periodStart DateTime     @db.Date
  periodEnd   DateTime     @db.Date
  status      PeriodStatus @default(open)
  lockedAt    DateTime?
  payments    Payment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdById String?      @db.Uuid

  @@unique([companyId, periodStart])
  @@map("payment_period")
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  periodId     String        @db.Uuid
  period       PaymentPeriod @relation(fields: [periodId], references: [id])
  employeeId   String        @db.Uuid
  employee     Employee      @relation(fields: [employeeId], references: [id])
  currency     String        @db.Char(3)
  total        Decimal       @db.Decimal(12, 2)
  status       PaymentStatus @default(calculated)
  paidAt       DateTime?
  paymentRef   String?
  approvedById String?       @db.Uuid
  approvedAt   DateTime?
  lines        PaymentLine[]
  bonuses      Bonus[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([periodId, employeeId, currency])
  @@map("payment")
}

model PaymentLine {
  id          String          @id @default(uuid()) @db.Uuid
  paymentId   String          @db.Uuid
  payment     Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  kind        PaymentLineKind
  amount      Decimal         @db.Decimal(12, 2)
  description String
  sourceIds   String[]
  createdAt   DateTime        @default(now())
  createdById String?         @db.Uuid

  @@index([paymentId])
  @@map("payment_line")
}

model Bonus {
  id          String      @id @default(uuid()) @db.Uuid
  employeeId  String      @db.Uuid
  employee    Employee    @relation(fields: [employeeId], references: [id])
  amount      Decimal     @db.Decimal(12, 2)
  currency    String      @db.Char(3)
  /// "YYYY-MM" the bonus is for
  period      String
  reason      String
  source      BonusSource @default(cs_incentive)
  status      BonusStatus @default(approved)
  requestId   String?     @unique @db.Uuid
  request     Request?    @relation(fields: [requestId], references: [id])
  /// technical: the payment the bonus was included in
  paymentId   String?     @db.Uuid
  payment     Payment?    @relation(fields: [paymentId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdById String?     @db.Uuid

  @@index([employeeId, status])
  @@map("bonus")
}

// ───────────── Phase 5: notifications (PRD 3, 8) ─────────────

enum NotificationChannel {
  in_app
  telegram
}

enum NotificationType {
  step_assigned
  step_overdue
  request_done
  request_rejected
}

model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  recipientId String              @db.Uuid
  recipient   User                @relation(fields: [recipientId], references: [id])
  type        NotificationType
  payload     Json
  channel     NotificationChannel
  readAt      DateTime?
  /// technical: delivery bookkeeping for external channels
  sentAt      DateTime?
  failedAt    DateTime?
  attempts    Int                 @default(0)
  error       String?
  createdAt   DateTime            @default(now())

  @@index([recipientId, channel, readAt])
  @@index([channel, sentAt, failedAt])
  @@map("notification")
}
